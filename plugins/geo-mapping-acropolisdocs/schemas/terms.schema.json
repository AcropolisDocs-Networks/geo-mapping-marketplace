{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Terms register beside a deliverable (1.3.0, R1-TERMS). Not legal advice.",
  "type": "object",
  "required": ["register_version", "header", "deliverable", "stem", "built", "outputs", "rows", "components", "summary"],
  "properties": {
    "register_version": {"const": 1},
    "header": {"type": "string"},
    "deliverable": {"enum": ["map", "web map", "atlas", "sheet", "export", "data package", "video"]},
    "stem": {"type": "string", "minLength": 1},
    "title": {"type": ["string", "null"]},
    "built": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "kind", "layers", "licence", "how_used", "obligations", "status"],
        "properties": {
          "source": {"type": ["string", "null"]},
          "publisher": {"type": ["string", "null"]},
          "entry": {"type": ["string", "null"]},
          "file": {"type": ["string", "null"]},
          "kind": {"enum": ["data", "helper", "ground", "terrain", "tiles", "logo"]},
          "layers": {"type": "array", "items": {"type": ["string", "null"]}},
          "licence": {"type": "object", "properties": {"name": {"type": "string"}, "class": {"type": "string"}, "url": {"type": ["string", "null"]}}},
          "how_used": {"type": "array", "minItems": 1, "items": {"enum": ["drawn", "embedded data", "derived", "tiles", "API"]}},
          "obligations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "status"],
              "properties": {
                "kind": {"enum": ["attribution", "api notice", "share-alike", "non-commercial", "no redistribution", "logo", "terms accepted"]},
                "text": {"type": ["string", "null"]},
                "status": {"enum": ["met", "not met", "person to confirm"]},
                "where": {"type": "string"},
                "note": {"type": "string"}
              },
              "additionalProperties": false
            }
          },
          "status": {"enum": ["met", "not met", "person to confirm"]}
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {"type": "object", "required": ["component", "status"],
                "properties": {"component": {"type": "string"}, "licence": {"type": ["string", "null"]}, "file": {"type": "string"},
                               "obligations": {"type": "string"}, "status": {"enum": ["met", "not met", "person to confirm"]}}}
    },
    "summary": {"type": "object", "required": ["met", "not met", "person to confirm"],
                "properties": {"met": {"type": "integer"}, "not met": {"type": "integer"}, "person to confirm": {"type": "integer"}}}
  }
}

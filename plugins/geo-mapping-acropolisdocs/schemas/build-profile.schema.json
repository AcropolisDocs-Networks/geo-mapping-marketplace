{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "geo-mapping edition build profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "plugin_name", "distribution_filename", "default_content_brand", "house_brand",
               "brands_bundled", "brand_selection", "skills_excluded", "command_prefix",
               "description_vars", "mcp_server_name"],
  "properties": {
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
    "plugin_name": {"type": "string", "pattern": "^geo-mapping-[a-z][a-z0-9]*$"},
    "distribution_filename": {"type": "string", "pattern": "^geo-mapping-[a-z0-9]+_v\\{version\\}\\.plugin$"},
    "default_content_brand": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
    "house_brand": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
    "brands_bundled": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"}},
    "brand_selection": {"const": "selectable"},
    "skills_excluded": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "command_prefix": {"type": "string"},
    "description_vars": {
      "type": "object",
      "required": ["brand_phrase", "route_keywords"],
      "additionalProperties": {"type": "string"}
    },
    "mcp_server_name": {"type": "string"},
    "optional_integrations": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "env.json written by map-env-probe",
  "type": "object",
  "required": ["schema_version", "generated_at", "plugin", "python", "packages", "gdal", "egress", "device_bridge",
               "editions_installed", "single_edition_ok", "tier", "status_line"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string"},
    "plugin": {"type": "object", "required": ["name", "brand_selection", "brands_bundled", "default_content_brand"]},
    "python": {"type": "object", "required": ["version"]},
    "packages": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "gdal": {"type": "object", "required": ["available", "version", "drivers"]},
    "egress": {"type": "object", "required": ["classification", "checked", "results"],
               "properties": {"classification": {"enum": ["open", "allowlist", "closed", "unknown"]}}},
    "device_bridge": {"enum": ["yes", "no", "unknown"]},
    "web_tools": {"enum": ["yes", "no", "unknown"]},
    "editions_installed": {"type": "array", "items": {"type": "string"}},
    "single_edition_ok": {"type": "boolean"},
    "workdir": {"type": "string"},
    "workdir_persistence": {"enum": ["verified", "unverified", "session-only"]},
    "tier": {"enum": ["T0", "T1", "T2"]},
    "status_line": {"type": "string"}
  }
}
